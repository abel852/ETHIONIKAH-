# ============================================================
# Cloudflare R2 Storage Configuration
# ============================================================
# Get these from: Cloudflare Dashboard → R2 → Manage API Tokens
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key
R2_SECRET_ACCESS_KEY=your_r2_secret_key
R2_BUCKET_NAME=ethionikah-uploads
R2_ENDPOINT=https://your_account_id.r2.cloudflarestorage.com
# Public URL for serving files (custom domain or r2.dev URL)
R2_PUBLIC_URL=https://uploads.ethionikah.com
# Storage limit in bytes (default: 10GB = R2 free tier)
R2_STORAGE_LIMIT_BYTES=10737418240
# Retention periods (days) — old files auto-deleted from R2
R2_VERIFICATION_RETENTION_DAYS=90
R2_CHAT_RETENTION_DAYS=60
