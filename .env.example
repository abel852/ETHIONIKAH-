# ─── Application ──────────────────────────────
NODE_ENV=development
APP_NAME="Islamic Matchmaking Platform"
APP_URL=http://localhost:3000
API_URL=http://localhost:5000/api

# ─── Database ─────────────────────────────────
# Production: add ?connection_limit=5&pool_timeout=30 to DATABASE_URL
#   connection_limit=5 per PM2 instance (2 instances = 10 total connections)
#   pool_timeout=30 seconds to wait for a connection before failing
DATABASE_URL=postgresql://postgres:password@localhost:5432/marriage_db?connection_limit=5&pool_timeout=30

# ─── Redis ────────────────────────────────────
REDIS_URL=redis://:password@localhost:6379

# ─── JWT ─────────────────────────────────────
JWT_SECRET=change_me_jwt_secret_32_chars_min
JWT_REFRESH_SECRET=change_me_refresh_secret_32_chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── Email ───────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM=EthioNikah <your_email@gmail.com>

# ─── SMS ─────────────────────────────────────
TWILIO_ACCOUNT_SID=your_sid
TWILIO_AUTH_TOKEN=your_token
TWILIO_PHONE_NUMBER=+251xxxxxxxxx

# ─── Storage ────────────────────────────────
STORAGE_PROVIDER=cloudflare-r2
S3_ENDPOINT=https://your-endpoint.r2.cloudflarestorage.com
S3_REGION=auto
S3_ACCESS_KEY_ID=your_key
S3_SECRET_ACCESS_KEY=your_secret
S3_BUCKET_NAME=islamic-matchmaking-uploads

# ─── Security ───────────────────────────────
CORS_ORIGIN=http://localhost:3000
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=2000
HEALTH_ENCRYPTION_KEY=change_me_32_char_encryption_key_for_health

# ─── Socket.io ──────────────────────────────
MAX_SOCKET_CONNECTIONS=500
MAX_CONNECTIONS_PER_USER=3
SOCKET_PING_INTERVAL=25000
SOCKET_PING_TIMEOUT=60000

# ─── Backups ────────────────────────────────
BACKUP_EMAIL=admin@yoursite.com
BACKUP_CRON=0 0 * * *
