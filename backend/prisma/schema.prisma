generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  email                      String              @unique
  phone                      String              @unique
  createdAt                  DateTime            @default(now()) @map("created_at")
  dateOfBirth                DateTime            @map("date_of_birth")
  firstName                  String              @map("first_name")
  gender                     Gender
  isActive                   Boolean             @default(true) @map("is_active")
  isEmailVerified            Boolean             @default(false) @map("is_email_verified")
  isPhoneVerified            Boolean             @default(false) @map("is_phone_verified")
  isVerified                 Boolean             @default(false) @map("is_verified")
  lastLoginAt                DateTime?           @map("last_login_at")
  lastName                   String              @map("last_name")
  passwordHash               String              @map("password_hash")
  updatedAt                  DateTime            @updatedAt @map("updated_at")
  id                         String              @id @default(uuid()) @db.Uuid
  role                       Role                @default(user)
  phoneOtp                   String?             @map("phone_otp")
  phoneOtpExpiry             DateTime?           @map("phone_otp_expiry")
  phoneOtpAttempts           Int                 @default(0) @map("phone_otp_attempts")
  resetToken                 String?             @map("reset_token")
  resetTokenExpiry           DateTime?           @map("reset_token_expiry")
  googleAuthSecret           String?             @map("google_auth_secret")
  twoFactorEnabled           Boolean             @default(false) @map("two_factor_enabled")
  twoFactorFailedAttempts    Int                 @default(0) @map("two_factor_failed_attempts")
  twoFactorLockedUntil       DateTime?           @map("two_factor_locked_until")
  twoFactorPermanentlyLocked Boolean             @default(false) @map("two_factor_permanently_locked")
  loginLockoutCount          Int                 @default(0) @map("login_lockout_count")
  loginLockedUntil           DateTime?           @map("login_locked_until")
  loginPermanentlyLocked     Boolean             @default(false) @map("login_permanently_locked")
  failedAttemptsInRound      Int                 @default(0) @map("failed_attempts_in_round")
  lockoutLevel               Int                 @default(0) @map("lockout_level")
  isFlaggedForReview         Boolean             @default(false) @map("is_flagged_for_review")
  lastForgotPasswordAt       DateTime?           @map("last_forgot_password_at")
  forgotPasswordCount        Int                 @default(0) @map("forgot_password_count")
  adminPinned                Boolean             @default(false) @map("admin_pinned")
  totalFailedAttempts10Days  Int                 @default(0) @map("total_failed_attempts_10_days")
  lastFailedAttemptAt        DateTime?           @map("last_failed_attempt_at")
  backupCodes                String?             @map("backup_codes")
  tokenVersion               Int                 @default(0) @map("token_version")
  usedBackupCodes            String?             @map("used_backup_codes")
  adminRole                  String?             @map("admin_role")
  admin_viewed_at            DateTime?
  username                   String?             @unique
  language                   String              @default("en") @db.VarChar(255)
  emailNotifications         Boolean             @default(true) @map("email_notifications")
  deletedAt                  DateTime?           @map("deleted_at")
  isDeleted                  Boolean             @default(false) @map("is_deleted")
  deletedBy                  String?             @map("deleted_by") @db.Uuid
  dataDeletionRequestedAt    DateTime?           @map("data_deletion_requested_at")
  permissions                AdminPermission[]
  affiliateReferred          AffiliateReferral[] @relation("Referred")
  affiliateReferrals         AffiliateReferral[] @relation("Referrer")
  auditLogs                  AuditLog[]
  adminComplaints            Complaint[]         @relation("AdminComplaint")
  complaints                 Complaint[]
  flaggedContent             ContentFlag[]       @relation("FlaggedContent")
  reviewedContent            ContentFlag[]       @relation("ReviewedContent")
  favorites                  Favorite[]
  receivedMatches            Match[]             @relation("ReceivedMatches")
  sentMatches                Match[]             @relation("SentMatches")
  receivedMessages           Message[]           @relation("ReceivedMessages")
  sentMessages               Message[]           @relation("SentMessages")
  notifications              Notification[]
  payments                   Payment[]
  profile                    Profile?
  wallet                     Wallet?
  boosts                     Boost[]
  contactCredits             UserContactCredit[]
  reported                   Report[]            @relation("ReportedUser")
  reports                    Report[]            @relation("Reporter")
  subscriptions              Subscription[]
  adminRestrictions          UserRestriction[]   @relation("AdminRestrictions")
  restrictions               UserRestriction[]
  adminVerifications         Verification[]      @relation("AdminVerification")
  verification               Verification?
  blockedBy                  BlockedUser[]       @relation("BlockedBy")
  blockedUsers               BlockedUser[]       @relation("BlockedUsers")
  profileViews               ProfileView[]       @relation("ProfileViewer")
  profileViewedBy            ProfileView[]       @relation("ProfileViewed")
  bookPurchases              BookPurchase[]
  conversationRequestsSent     ConversationRequest[]   @relation("ConversationRequester")
  conversationRequestsReceived ConversationRequest[]   @relation("ConversationReceiver")
  exclusivePartnershipsA      ExclusivePartnership[]  @relation("PartnershipUserA")
  exclusivePartnershipsB      ExclusivePartnership[]  @relation("PartnershipUserB")
  partnershipRequestsSent      ExclusivePartnershipRequest[] @relation("PartnershipRequester")
  partnershipRequestsReceived  ExclusivePartnershipRequest[] @relation("PartnershipReceiver")
  waliInvitationsCreated       WaliInvitation[]              @relation("WaliCreatedBy")
  wali                         Wali?
  pushSubscriptions            PushSubscription[]

  @@index([isActive, isVerified, deletedAt])
  @@index([role, isActive])
  @@map("users")
}

model Profile {
  id                       String            @id @default(uuid()) @db.Uuid
  userId                   String            @unique @map("user_id") @db.Uuid
  nationality              String?
  region                   String?
  height                   Int?
  weight                   String?
  appearance               String?
  hasWali                  String?
  waliName                 String?
  waliPhone                String?
  waliRelation             String?
  hasChildren              String?
  childrenCount            String?
  childrenCustody          String?
  childrenStatus           String?           @map("children_status")
  religiousCommitment      String?           @map("religious_commitment")
  prayerHabits             String?           @map("prayer_habits")
  quranReadingFrequency    String?           @map("quran_reading_frequency")
  islamicClassesAttendance String?           @map("islamic_classes_attendance")
  islamicTradition         String?           @map("islamic_tradition")
  islamicTraditionOther    String?           @map("islamic_tradition_other")
  islamicMatchPreference   String?           @map("islamic_match_preference")
  personalPreference       String?           @map("personal_preference")
  educationLevel           String?           @map("education_level")
  occupation               String?
  employmentStatus         String?           @map("employment_status")
  monthlyIncomeRange       String?           @map("monthly_income_range")
  reasonForJoining         String?           @map("reason_for_joining")
  desiredMarriageTimeline  String?           @map("desired_marriage_timeline")
  childrenPreference       String?           @map("children_preference")
  ethnicBackground         String?           @map("ethnic_background")
  motherTongue             String?           @map("mother_tongue")
  familyInvolvement        String?           @map("family_involvement")
  smokingHabits            String?           @map("smoking_habits")
  khatUsage                String?           @map("khat_usage")
  exerciseHabits           String?           @map("exercise_habits")
  livingPreference         String?           @map("living_preference")
  selfDescription          String?           @map("self_description")
  qualities                String[]
  interests                String[]
  bio                      String?
  country                  String?
  city                     String?
  maritalStatus            MaritalStatus     @default(single) @map("marital_status")
  religiousLevel           String?           @map("religious_level")
  ethnicity                String?
  languages                String[]
  photos                   String[]
  isProfileComplete        Boolean           @default(false) @map("is_profile_complete")
  createdAt                DateTime          @default(now()) @map("created_at")
  updatedAt                DateTime          @updatedAt @map("updated_at")
  healthInfo               HealthInfo?
  user                     User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  spousePreference         SpousePreference?

  @@map("profiles")
}

model Verification {
  adminId                String?            @map("admin_id") @db.Uuid
  adminNote              String?            @map("admin_note")
  createdAt              DateTime           @default(now()) @map("created_at")
  idDocumentPath         String?            @map("id_document_path")
  reviewedAt             DateTime?          @map("reviewed_at")
  selfiePath             String?            @map("selfie_path")
  status                 VerificationStatus @default(pending)
  updatedAt              DateTime           @updatedAt @map("updated_at")
  userId                 String             @unique @map("user_id") @db.Uuid
  id                     String             @id @default(uuid()) @db.Uuid
  additionalDocumentPath String?            @map("additional_document_path")
  viewed_at              DateTime?
  admin                  User?              @relation("AdminVerification", fields: [adminId], references: [id])
  user                   User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("verifications")
}

model Match {
  id                 String      @id @default(uuid()) @db.Uuid
  userId             String      @map("user_id") @db.Uuid
  matchedUserId      String      @map("matched_user_id") @db.Uuid
  compatibilityScore Float?      @map("compatibility_score")
  status             MatchStatus @default(pending)
  createdAt          DateTime    @default(now()) @map("created_at")
  updatedAt          DateTime    @updatedAt @map("updated_at")
  matchedUser        User        @relation("ReceivedMatches", fields: [matchedUserId], references: [id])
  user               User        @relation("SentMatches", fields: [userId], references: [id])

  @@index([userId, status])
  @@index([matchedUserId, status])
  @@map("matches")
}

model Message {
  id                   String    @id @default(uuid()) @db.Uuid
  senderId             String    @map("sender_id") @db.Uuid
  receiverId           String    @map("receiver_id") @db.Uuid
  content              String
  isRead               Boolean   @default(false) @map("is_read")
  readAt               DateTime? @map("read_at")
  createdAt            DateTime  @default(now()) @map("created_at")
  isEdited             Boolean   @default(false) @map("is_edited")
  editedAt             DateTime? @map("edited_at")
  deletedForReceiver  Boolean   @default(false) @map("deleted_for_receiver")
  deletedForSender    Boolean   @default(false) @map("deleted_for_sender")
  replyToId           String?   @map("reply_to_id") @db.Uuid
  reaction             String?   @map("reaction")
  reactionBy           String?   @map("reaction_by") @db.Uuid
  reactionAt           DateTime? @map("reaction_at")
  receiver             User      @relation("ReceivedMessages", fields: [receiverId], references: [id])
  replyTo              Message?  @relation("messagesTomessages", fields: [replyToId], references: [id])
  replyMessages        Message[] @relation("messagesTomessages")
  sender               User      @relation("SentMessages", fields: [senderId], references: [id])

  @@index([senderId, createdAt])
  @@index([receiverId, createdAt])
  @@index([receiverId, isRead])
  @@map("messages")
}

model Notification {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  type      String
  title     String
  body      String
  isRead    Boolean  @default(false) @map("is_read")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead, createdAt])
  @@index([type, createdAt])
  @@map("notifications")
}

model PushSubscription {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  endpoint  String
  keys      Json
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([endpoint])
  @@index([userId])
  @@map("push_subscriptions")
}

model Report {
  id             String       @id @default(uuid()) @db.Uuid
  reporterId     String       @map("reporter_id") @db.Uuid
  reportedUserId String       @map("reported_user_id") @db.Uuid
  reason         String
  description    String?
  status         ReportStatus @default(open)
  adminId        String?      @map("admin_id") @db.Uuid
  adminNote      String?      @map("admin_note")
  isPinned       Boolean      @default(false) @map("is_pinned")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  viewed_at      DateTime?
  reportedUser   User         @relation("ReportedUser", fields: [reportedUserId], references: [id])
  reporter       User         @relation("Reporter", fields: [reporterId], references: [id])

  @@index([status, createdAt])
  @@index([reportedUserId])
  @@map("reports")
}

model SpousePreference {
  createdAt                    DateTime @default(now()) @map("created_at")
  genderInteraction            String   @map("gender_interaction")
  mahrExpectation              String   @map("mahr_expectation")
  polygamyPreference           String   @map("polygamy_preference")
  preferredAgeMax              Int      @map("preferred_age_max")
  preferredAgeMin              Int      @map("preferred_age_min")
  preferredEducationLevel      String   @map("preferred_education_level")
  preferredLocation            String   @map("preferred_location")
  preferredMaritalStatus       String   @map("preferred_marital_status")
  preferredReligiousCommitment String   @map("preferred_religious_commitment")
  islamicMatchPreference       String?  @map("islamic_match_preference")
  profileId                    String   @unique @map("profile_id") @db.Uuid
  updatedAt                    DateTime @updatedAt @map("updated_at")
  waliInvolvement              String   @map("wali_involvement")
  id                           String   @id @default(uuid()) @db.Uuid
  profile                      Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@map("spouse_preferences")
}

model Subscription {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  planType  String    @map("plan_type")
  status    String
  startDate DateTime  @map("start_date")
  endDate   DateTime? @map("end_date")
  autoRenew Boolean   @default(false) @map("auto_renew")
  paymentId String?   @map("payment_id")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  payments  Payment[]
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([endDate])
  @@map("subscriptions")
}

model Payment {
  id              String        @id @default(uuid()) @db.Uuid
  userId          String        @map("user_id") @db.Uuid
  subscriptionId  String?       @map("subscription_id") @db.Uuid
  planType        String        @map("plan_type")
  amount          Float
  currency        String        @default("ETB")
  status          PaymentStatus @default(pending)
  paymentMethod   String        @map("payment_method")
  transactionId   String?       @map("transaction_id")
  referenceNumber String?       @map("reference_number")
  receiptUrl      String?       @map("receipt_url")
  adminNote       String?       @map("admin_note")
  verifiedAt      DateTime?     @map("verified_at")
  verifiedBy      String?       @map("verified_by") @db.Uuid
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")
  subscription    Subscription? @relation(fields: [subscriptionId], references: [id])
  boost           Boost?
  receipt         PaymentReceipt?
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([status, createdAt])
  @@map("payments")
}

model Wallet {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @unique @map("user_id") @db.Uuid
  credits     Int      @default(0)
  totalSpent  Float    @default(0) @map("total_spent")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("wallets")
}

model Boost {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  paymentId String?   @unique @map("payment_id") @db.Uuid
  status    String    @default("pending")
  startsAt  DateTime? @map("starts_at")
  endsAt    DateTime? @map("ends_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  payment   Payment?  @relation(fields: [paymentId], references: [id])
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("boosts")
}

model MembershipPlan {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique
  name        String
  description String?
  price       Float
  currency    String   @default("ETB")
  durationDays Int     @map("duration_days")
  planType    String   @map("plan_type")
  features    String[]
  isActive    Boolean  @default(true) @map("is_active")
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("membership_plans")
}

model ContactCreditPackage {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique
  name        String
  credits     Int
  price       Float
  currency    String   @default("ETB")
  isActive    Boolean  @default(true) @map("is_active")
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("contact_credit_packages")
}

model PaymentMethod {
  id            String   @id @default(uuid()) @db.Uuid
  key           String   @unique
  name          String
  instructions  String?
  accountInfo   String?  @map("account_info")
  isActive      Boolean  @default(true) @map("is_active")
  sortOrder     Int      @default(0) @map("sort_order")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("payment_methods")
}

model UserContactCredit {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  credits   Int      @default(0)
  usedCredits Int    @default(0) @map("used_credits")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId])
  @@map("user_contact_credits")
}

model PaymentReceipt {
  id          String   @id @default(uuid()) @db.Uuid
  paymentId   String   @unique @map("payment_id") @db.Uuid
  fileUrl     String   @map("file_url")
  fileType    String   @map("file_type")
  fileSize    Int?     @map("file_size")
  createdAt   DateTime @default(now()) @map("created_at")
  payment     Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@map("payment_receipts")
}

model Complaint {
  id            String    @id @default(uuid()) @db.Uuid
  userId        String?   @map("user_id") @db.Uuid
  subject       String
  description   String
  status        String    @default("open")
  adminId       String?   @map("admin_id") @db.Uuid
  adminResponse String?   @map("admin_response")
  isPinned      Boolean   @default(false) @map("is_pinned")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  viewed_at     DateTime?
  admin         User?     @relation("AdminComplaint", fields: [adminId], references: [id])
  user          User?     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([status, createdAt])
  @@map("complaints")
}

model Favorite {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String   @map("user_id") @db.Uuid
  favoritedUserId String   @map("favorited_user_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at")
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, favoritedUserId])
  @@map("favorites")
}

model UserRestriction {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  type      String
  reason    String?
  duration  Int?
  expiresAt DateTime? @map("expires_at")
  createdAt DateTime  @default(now()) @map("created_at")
  createdBy String?   @map("created_by") @db.Uuid
  admin     User?     @relation("AdminRestrictions", fields: [createdBy], references: [id])
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_restrictions")
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String   @map("admin_id") @db.Uuid
  actorType  String   @default("ADMIN") @map("actor_type")
  action     String
  resource   String
  resourceId String?  @map("resource_id")
  details    Json?
  ipAddress  String?  @map("ip_address")
  createdAt  DateTime @default(now()) @map("created_at")
  actor      User     @relation(fields: [actorId], references: [id])

  @@map("audit_logs")
}

model FeatureToggle {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique
  label       String
  description String?
  enabled     Boolean  @default(false)
  category    String   @default("general")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("feature_toggles")
}

model AdminPermission {
  id         String   @id @default(uuid()) @db.Uuid
  adminId    String   @map("admin_id") @db.Uuid
  permission String
  createdAt  DateTime @default(now()) @map("created_at")
  admin      User     @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@unique([adminId, permission])
  @@map("admin_permissions")
}

model ContentFlag {
  id          String    @id @default(uuid()) @db.Uuid
  targetType  String    @map("target_type")
  targetId    String    @map("target_id")
  flaggedById String?   @map("flagged_by_id") @db.Uuid
  reason      String
  aiScore     Float?    @map("ai_score")
  status      String    @default("pending")
  reviewedBy  String?   @map("reviewed_by") @db.Uuid
  adminNote   String?   @map("admin_note")
  createdAt   DateTime  @default(now()) @map("created_at")
  reviewedAt  DateTime? @map("reviewed_at")
  flaggedBy   User?     @relation("FlaggedContent", fields: [flaggedById], references: [id])
  reviewer    User?     @relation("ReviewedContent", fields: [reviewedBy], references: [id])

  @@map("content_flags")
}

model AffiliateReferral {
  id           String    @id @default(uuid()) @db.Uuid
  referrerId   String    @map("referrer_id") @db.Uuid
  referredId   String    @map("referred_id") @db.Uuid
  code         String    @map("code")
  status       String    @default("pending")
  rewardAmount Float?    @map("reward_amount")
  createdAt    DateTime  @default(now()) @map("created_at")
  convertedAt  DateTime? @map("converted_at")
  referred     User      @relation("Referred", fields: [referredId], references: [id])
  referrer     User      @relation("Referrer", fields: [referrerId], references: [id])

  @@map("affiliate_referrals")
}

model Promotion {
  id        String    @id @default(uuid()) @db.Uuid
  code      String    @unique
  type      String    @default("percentage")
  value     Float
  maxUses   Int?
  usedCount Int       @default(0) @map("used_count")
  minAmount Float?    @map("min_amount")
  startsAt  DateTime  @map("starts_at")
  expiresAt DateTime? @map("expires_at")
  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at")

  @@map("promotions")
}

model NotificationTemplate {
  id        String   @id @default(uuid()) @db.Uuid
  key       String   @unique
  type      String   @default("email")
  subject   String?
  body      String
  variables String[]
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("notification_templates")
}

model SystemSetting {
  id        String   @id @default(uuid()) @db.Uuid
  key       String   @unique
  value     Json
  category  String   @default("general")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("system_settings")
}

model HealthInfo {
  id                          String   @id @db.Uuid
  profile_id                  String   @unique @db.Uuid
  hiv_status                  String?
  std_status                  String?
  std_details                 String?
  hereditary_diseases         String?
  hereditary_details          String?
  chronic_conditions          String?
  chronic_details             String?
  disabilities                String?
  disability_details          String?
  dwarfism_status             String?
  dwarfism_details            String?
  other_conditions            String?
  share_with_matches          Boolean  @default(false)
  hiv_match_preference        String?  @default("any")
  std_match_preference        String?  @default("any")
  hereditary_match_preference String?  @default("any")
  health_match_preference     String?  @default("any")
  created_at                  DateTime @default(now())
  updated_at                  DateTime
  profile                     Profile  @relation(fields: [profile_id], references: [id], onDelete: Cascade)

  @@map("health_info")
}

model ProfileView {
  id        String   @id @default(uuid()) @db.Uuid
  viewerId  String   @map("viewer_id") @db.Uuid
  viewedId  String   @map("viewed_id") @db.Uuid
  viewedAt  DateTime @default(now()) @map("viewed_at")
  viewer    User     @relation("ProfileViewer", fields: [viewerId], references: [id], onDelete: Cascade)
  viewed    User     @relation("ProfileViewed", fields: [viewedId], references: [id], onDelete: Cascade)

  @@unique([viewerId, viewedId])
  @@index([viewedId])
  @@index([viewerId, viewedAt])
  @@map("profile_views")
}

model BlockedUser {
  id        String   @id @default(uuid()) @db.Uuid
  blockerId String   @map("blocker_id") @db.Uuid
  blockedId String   @map("blocked_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  blocker   User     @relation("BlockedUsers", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked   User     @relation("BlockedBy", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@map("blocked_users")
}

model Book {
  id          String   @id @default(uuid()) @db.Uuid
  title       String
  author      String
  description String?
  coverImage  String?  @map("cover_image")
  fileUrl     String   @map("file_url")
  fileType    String   @default("pdf") @map("file_type")
  price       Float    @default(0)
  currency    String   @default("ETB")
  category    String?
  isActive    Boolean  @default(true) @map("is_active")
  createdBy   String?  @map("created_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  purchases   BookPurchase[]

  @@map("books")
}

model BookPurchase {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  bookId    String   @map("book_id") @db.Uuid
  amount    Float
  currency  String   @default("ETB")
  status    String   @default("approved")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  book      Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@unique([userId, bookId])
  @@map("book_purchases")
}

model ConversationRequest {
  id           String    @id @default(uuid()) @db.Uuid
  requesterId  String    @map("requester_id") @db.Uuid
  receiverId   String    @map("receiver_id") @db.Uuid
  status       String    @default("pending") // pending | accepted | declined | expired
  message      String?
  createdAt    DateTime  @default(now()) @map("created_at")
  respondedAt  DateTime? @map("responded_at")
  requester    User      @relation("ConversationRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  receiver     User      @relation("ConversationReceiver", fields: [receiverId], references: [id], onDelete: Cascade)

  @@unique([requesterId, receiverId])
  @@index([receiverId, status])
  @@index([requesterId, status])
  @@map("conversation_requests")
}

model ExclusivePartnership {
  id         String    @id @default(uuid()) @db.Uuid
  userAId    String    @map("user_a_id") @db.Uuid
  userBId    String    @map("user_b_id") @db.Uuid
  status     String    @default("pending") // pending | active | ended
  createdAt  DateTime  @default(now()) @map("created_at")
  endedAt    DateTime? @map("ended_at")
  userA      User      @relation("PartnershipUserA", fields: [userAId], references: [id], onDelete: Cascade)
  userB      User      @relation("PartnershipUserB", fields: [userBId], references: [id], onDelete: Cascade)
  waliInvitations WaliInvitation[]

  @@unique([userAId, userBId])
  @@index([userAId, status])
  @@index([userBId, status])
  // DB-level safeguard: partial unique indexes prevent a user from having
  // more than one active partnership simultaneously:
  //   CREATE UNIQUE INDEX idx_one_active_partnership_a ON exclusive_partnerships (user_a_id) WHERE status = 'active'
  //   CREATE UNIQUE INDEX idx_one_active_partnership_b ON exclusive_partnerships (user_b_id) WHERE status = 'active'
  @@map("exclusive_partnerships")
}

model ExclusivePartnershipRequest {
  id           String    @id @default(uuid()) @db.Uuid
  requesterId  String    @map("requester_id") @db.Uuid
  receiverId   String    @map("receiver_id") @db.Uuid
  status       String    @default("pending") // pending | accepted | declined | expired | cancelled
  message      String?
  createdAt    DateTime  @default(now()) @map("created_at")
  respondedAt  DateTime? @map("responded_at")
  requester    User      @relation("PartnershipRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  receiver     User      @relation("PartnershipReceiver", fields: [receiverId], references: [id], onDelete: Cascade)

  @@index([requesterId, createdAt])
  @@index([receiverId, status])
  @@map("exclusive_partnership_requests")
}

model Wali {
  id           String           @id @default(uuid()) @db.Uuid
  femaleUserId String           @unique @map("female_user_id") @db.Uuid
  name         String
  relationship WaliRelationship
  email        String
  phone        String
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")
  femaleUser   User             @relation(fields: [femaleUserId], references: [id], onDelete: Cascade)
  invitations  WaliInvitation[]

  @@map("walis")
}

model WaliInvitation {
  id              String    @id @default(uuid()) @db.Uuid
  partnershipId   String    @map("partnership_id") @db.Uuid
  createdById     String    @map("created_by_id") @db.Uuid
  waliId          String?   @map("wali_id") @db.Uuid
  secureTokenHash String    @map("secure_token_hash")
  status          String    @default("pending_approval") // pending_approval | active | revoked | expired | declined
  expiresAt       DateTime  @map("expires_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  revokedAt       DateTime? @map("revoked_at")
  lastAccessedAt  DateTime? @map("last_accessed_at")
  partnership     ExclusivePartnership @relation(fields: [partnershipId], references: [id], onDelete: Cascade)
  createdBy       User      @relation("WaliCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)
  wali            Wali?     @relation(fields: [waliId], references: [id], onDelete: Cascade)

  @@unique([partnershipId])
  @@index([secureTokenHash])
  @@map("wali_invitations")
}

enum Gender {
  male
  female
}

enum WaliRelationship {
  FATHER
  GRANDFATHER
  BROTHER
  UNCLE
  LEGAL_GUARDIAN
  OTHER
}

enum Role {
  user
  admin
}

enum MaritalStatus {
  single
  divorced
  widowed
  single_never
  single_previous
  married
}

enum MatchStatus {
  pending
  accepted
  rejected
}

enum VerificationStatus {
  pending
  approved
  rejected
}

enum ReportStatus {
  open
  investigating
  resolved
  dismissed
}

enum PaymentStatus {
  pending
  approved
  rejected
}
